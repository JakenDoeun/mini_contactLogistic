    "build": "next build",
    "start": "node scripts/serve.ts",
    "start:lan": "node scripts/serve.ts",
    "test": "node --test \"src/**/*.test.ts\"",
    "test:integration": "node --test --test-concurrency=1 \"test/integration/*.test.ts\"",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node scripts/db-migrate.ts",
    "db:seed": "node scripts/db-seed.ts",
    "user": "node scripts/user.ts",
    "first-run-code": "node scripts/first-run-code.ts",
    "gateway": "node scripts/gateway.ts",
    "recovery-code": "node scripts/recovery-code.ts",
    "serve": "node scripts/serve.ts",
    "sms-worker": "node scripts/sms-worker.ts",
    "restore": "node scripts/restore.ts",
    "locales": "node scripts/locales.ts"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "1.2.0",
    "@radix-ui/react-slot": "1.4.0",
    "@zxing/browser": "0.2.1",
    "@zxing/library": "0.23.0",
    "animejs": "4.5.0",
    "better-sqlite3": "13.0.3",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "drizzle-orm": "0.45.4",
    "geist": "1.7.2",
    "lucide-react": "0.544.0",
    "next": "16.4.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "tailwind-merge": "3.7.0",
    "xlsx": "file:vendor/xlsx-0.20.3.tgz"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@types/better-sqlite3": "9.6.0",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "drizzle-kit": "0.31.11",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3"
  },
  "engines": {
    "node": ">=24.21.0 <25"
  },
  "allowScripts": {
    "better-sqlite3": false,
    "esbuild": true
  }
